      "bundleIdentifier": "com.tomaslonati.calculomental"
    },
    "android": {
      "package": "com.tomaslonati.calculomental",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font"]
  }
}
